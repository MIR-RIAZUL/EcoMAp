# EchoMap — Supabase Configuration
# Duplicate this file as `.env` and fill in your Supabase project credentials.
# Do NOT commit `.env` or any production secrets to version control.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Do NOT use service_role / secret key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-publishable-key

